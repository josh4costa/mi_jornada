# .env.example  —  copia a .env y rellena
# Genera SECRET_KEY con:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=mi_jornada_user
POSTGRES_PASSWORD=
POSTGRES_DB=mi_jornada

SECRET_KEY=
ENVIRONMENT=production

# Dominios permitidos (separados por coma). En producción NO puede ser '*'.
BACKEND_CORS_ORIGINS=https://myjornada.pleg.com.mx

TIMEZONE=America/Monterrey
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Saltos de proxy hasta el backend: Traefik + nginx = 2
TRUSTED_PROXY_HOPS=2

# Webhooks n8n (opcionales)
WEBHOOK_CHECK_IN_URL=
WEBHOOK_CHECK_OUT_URL=
WEBHOOK_TASK_COMPLETED_URL=
